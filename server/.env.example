# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/civicpulse
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/civicpulse
MONGODB_URI=mongodb://localhost:27017/civicpulse

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Redis Cloud: redis://:password@host:port
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_64_char_hex_string
JWT_REFRESH_SECRET=REPLACE_ME_DIFFERENT_64_char_hex_string

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Resend (Email) ─────────────────────────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=re_123456789
EMAIL_FROM=CivicPulse <onboarding@resend.dev>

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_EMAIL=admin@civicpulse.com
VAPID_PUBLIC_KEY=REPLACE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_ME_VAPID_PRIVATE_KEY
